# Optional settings. Every value below is the default, so you only need this
# file if you want to change something.
#
# Copy it:   cp .env.example .env
# Use it:    npx tsx --env-file=.env day-30/server.ts   (Node 20.6+)
# Or just set a variable inline:  OLLAMA_MODEL=qwen2.5:7b npm run day -- 10

# Chat model used by every day (pick one that supports tool calling for Days 9-14 and 25)
OLLAMA_MODEL=qwen2.5:3b

# Embedding model used by Days 15-30.
# After changing it, delete old store.json files so vectors are rebuilt.
EMBED_MODEL=nomic-embed-text

# Where Ollama is running (used by Day 22 and npm run doctor)
OLLAMA_HOST=http://127.0.0.1:11434

# Day 30 Docs Assistant
PORT=3000
# DOCS_FOLDER=~/my-notes     # folder of .md/.txt files to answer from (default: day-30/docs)
